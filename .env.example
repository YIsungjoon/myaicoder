# myAiCoder Environment Variables
# Copy to .env and adjust values:
#   cp .env.example .env

# ── LLM Server ──
MYAICODER_LLM_URL=http://localhost:8080/v1   # LLM API 엔드포인트 (원격 서버 예시: http://<HOST>:8080/v1)
MYAICODER_LLM_MODEL=qwen3.5-9b              # 모델명 (서버의 /v1/models 에서 확인)
MYAICODER_API_KEY=                          # Gateway API 키 (없으면 비워둠)

# ── 로컬 llama.cpp 직접 실행 시 ──
LLAMA_SERVER_PATH=          # llama-server 바이너리 경로 (비워두면 PATH에서 자동 탐지)
MODELS_DIR=~/models         # GGUF 모델 파일 디렉토리

# ── Gateway ──
GATEWAY_CONFIG=config/gateway.yaml

# ── Monitoring (optional) ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
